# Copy this file to .env and add your Gemini API key.
GEMINI_API_KEY=your_api_key_here
# The project defaults to a currently supported Gemini model.
# The documentation specified Gemini 1.5 Flash Pro, but Gemini 1.5 Flash was shut down in 2025.
GEMINI_MODEL=gemini-3.5-flash
SECRET_KEY=change-this-to-a-long-random-secret
DATABASE_PATH=data/pocketsmart.db
MAX_UPLOAD_MB=5
